{
  "name": "杂七杂八",
  "description": "杂七杂八的插件",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "contextMenus",
    "tabs",
    "notifications",
    "storage",
    "commands",
    "tts",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "index.mjs"
      ],
      "css": [
        "scrollbar.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "homepage_url": "https://mh33.top/payList",
  "omnibox": {
    "keyword": "mv"
  },
  "action": {
    "default_popup": "popop.html",
    "default_icon": "icon.png"
  },
  "commands": {
    "switch-left-tab": {
      "suggested_key": "Ctrl+Shift+Left",
      "description": "切换到上一个标签"
    },
    "switch-right-tab": {
      "suggested_key": "Ctrl+Shift+Right",
      "description": "切换到下一个标签"
    }
  },
  "chrome_url_overrides": {}
}