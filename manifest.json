{
  "name": "多功能浏览器增强工具",
  "description": "多功能浏览器增强工具",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "contextMenus",
    "tabs",
    "activeTab",
    "notifications",
    "commands",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:39002/*",
    "https://*.bilibili.com/*",
    "https://bilibili.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:39002 https://*"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["index.mjs"]
    }
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "homepage_url": "https://mh33.top/payList",
  "omnibox": {
    "keyword": "mv"
  },
  "commands": {
    "switch-left-tab": {
      "suggested_key": "Ctrl+Shift+Left",
      "description": "切换到上一个标签"
    },
    "switch-right-tab": {
      "suggested_key": "Ctrl+Shift+Right",
      "description": "切换到下一个标签"
    }
  },
  "chrome_url_overrides": {}
}
